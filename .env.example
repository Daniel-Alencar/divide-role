# Copie para .env.local e preencha. Nunca versione o .env.local.

# Endereço público do site (sem barra no fim). Usado no sitemap e nas prévias de link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: todo acesso ao banco passa pelo servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Project Settings > API Keys: chave "secret" (sb_secret_...). Nunca exponha no navegador.
SUPABASE_SECRET_KEY=

# Só na sua máquina, para `npm run db:migrate`. Supabase > Connect > Session pooler.
# Nunca configure na Vercel.
DATABASE_URL=

# Códigos de verificação do Google Search Console e do Bing Webmaster Tools (opcionais).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# E-mail de contato exibido na política de privacidade e nos termos (opcional).
NEXT_PUBLIC_CONTATO_EMAIL=

# Google AdSense (deixe vazio para não exibir anúncios nem o aviso de cookies)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RODAPE=
NEXT_PUBLIC_ADSENSE_SLOT_ACERTO=
